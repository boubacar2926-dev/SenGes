# Valeurs ci-dessous adaptées au développement local. En production (Render),
# définir explicitement APP_ENV=production, APP_DEBUG=false et un LOG_LEVEL
# moins verbeux (ex: error) via les variables d'environnement de l'hébergeur :
# APP_DEBUG=true en production exposerait la stack trace (code, requêtes SQL,
# valeurs de configuration) aux visiteurs sur toute erreur.
APP_NAME=SenGes
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Cookies de session envoyés uniquement en HTTPS. À définir sur "true" en
# production (Render sert l'app en HTTPS) ; laisser vide/false en local HTTP.
SESSION_SECURE_COOKIE=

# Restreint les origines autorisées à appeler /api/* et /sanctum/csrf-cookie.
# Vide = comportement par défaut de Laravel (toutes origines, cf config/cors.php).
# Exemple en production : CORS_ALLOWED_ORIGINS=https://senges.onrender.com
CORS_ALLOWED_ORIGINS=

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

# Comptes créés par `php artisan db:seed` (DatabaseSeeder), exécuté à chaque
# démarrage du conteneur. Laisser vide = aucun compte n'est seedé.
# Le seeder utilise firstOrCreate() : si le compte existe déjà, sa valeur
# n'est jamais écrasée, donc changer ces variables plus tard ne réinitialise
# PAS un mot de passe déjà en base (voir commande artisan dédiée si besoin).
# À définir comme variables d'environnement sur l'hébergeur (ex: Render),
# jamais en dur dans le code ni committées dans ce fichier.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Commerçant de démonstration (optionnel). Laisser vide = non seedé.
SEED_DEMO_COMMERCANT_EMAIL=
SEED_DEMO_COMMERCANT_PASSWORD=
SEED_DEMO_PRODUCTS_COUNT=20

# CACHE_DRIVER et SESSION_DRIVER : laissés vides ici pour du développement
# local (retombent sur "file"). En production, le disque de l'hébergeur
# (Render) est éphémère : config/cache.php et config/session.php basculent
# donc automatiquement sur "database" quand APP_ENV=production et qu'aucune
# de ces deux variables n'est définie explicitement, pour survivre aux
# redémarrages du conteneur (sessions + rate limiter de connexion).
BROADCAST_DRIVER=log
CACHE_DRIVER=
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
